@SlotStyle = TextButtonStyle(
    Default: (Background: "ButtonInput_Background.png", LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: "ButtonInput_Hovered_Background.png", LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: "ButtonInput_Selected_Background.png", LabelStyle: (FontSize: 16, TextColor: #aaccff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Sounds: (
             MouseHover: (SoundPath: "Selection_Hover.ogg", Volume: 0.7),
             Activate: (SoundPath: "Selection_Press.ogg", Volume: 0.7)
             )
    );

@DoneStyle = TextButtonStyle(
    Default: (Background: "DoneButton_Background.png", LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: "DoneButton_Hovered_Background.png", LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: "DoneButton_Pressed_Background.png", LabelStyle: (FontSize: 18, TextColor: #aaccff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Sounds: (
                      MouseHover: (SoundPath: "Selection_Hover.ogg", Volume: 0.7),
                      Activate: (SoundPath: "Selection_Press.ogg", Volume: 0.7)
                      )
    );

Group {
    Anchor: (Width: 1100, Height: 670);
    Background: #000000(1);
    LayoutMode: Top;
    Padding: (Full: 24);

    Group{
        LayoutMode: Left;

        Label {
                Text: "";
                Background: "KIDO_LOADOUT_TEXT.png";
                Anchor: (Height: 40, Width: 200);
            }

    }


    Label #ActiveSlotHint {
        Text: "Select a slot, then choose a kido";
        Anchor: (Height: 26);
        Style: (FontSize: 16, TextColor: #88aacc);
    }

    Group { Anchor: (Height: 14); }

    Group {
        LayoutMode: Left;
        Anchor: (Height: 472);

        Group {
            LayoutMode: Top;
            Anchor: (Width: 400);

            Label {
                Text: "INPUTS";
                Anchor: (Height: 26);
                Style: (FontSize: 14, TextColor: #5B8FBF, RenderBold: true);
            }
            Group { Anchor: (Height: 8); }

            TextButton #SlotNoneButton {
                Text: "Left-Click: Empty";
                Anchor: (Height: 65);
                Style: @SlotStyle;
                Padding: (Left: 16);
            }
            Group { Anchor: (Height: 6); }

            TextButton #SlotForwardButton {
                Text: "+ Forward: Empty";
                Anchor: (Height: 65);
                Style: @SlotStyle;
                Padding: (Left: 16);
            }
            Group { Anchor: (Height: 6); }

            TextButton #SlotBackButton {
                Text: "+ Back: Empty";
                Anchor: (Height: 65);
                Style: @SlotStyle;
                Padding: (Left: 16);
            }
            Group { Anchor: (Height: 6); }

            TextButton #SlotLeftButton {
                Text: "+ Left: Empty";
                Anchor: (Height: 65);
                Style: @SlotStyle;
                Padding: (Left: 16);
            }
            Group { Anchor: (Height: 6); }

            TextButton #SlotRightButton {
                Text: "+ Right: Empty";
                Anchor: (Height: 65);
                Style: @SlotStyle;
                Padding: (Left: 16);
            }
        }

        Group { Anchor: (Width: 24); }

        Group {
            LayoutMode: Top;
            FlexWeight: 1;

            Label {
                Text: "TECHNIQUES";
                Anchor: (Height: 26);
                Style: (FontSize: 14, TextColor: #5B8FBF, RenderBold: true);
            }
            Group { Anchor: (Height: 8); }

            Group #KidoList {
                LayoutMode: Top;
                Anchor: (Height: 438);
                ContentHeight: 1000;
                ScrollbarStyle: (
                    Size: 5,
                    Handle: (Color: #3a5d7d),
                    HoveredHandle: (Color: #5B8FBF),
                    Background: ("Scrollbar_Background.png")
                );
            }
        }
    }

    Group { Anchor: (Height: 14); }

    TextButton #DoneButton {
        Text: "DONE";
        Anchor: (Height: 46, Width: 300);
        Style: @DoneStyle;
        Padding: (Left: 16);
    }
}
