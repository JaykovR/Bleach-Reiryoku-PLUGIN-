@MenuButtonStyle = TextButtonStyle(
    Default: (Background: "ButtonInput_Background.png", LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: "ButtonInput_Hovered_Background.png", LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: "ButtonInput_Selected_Background.png", LabelStyle: (FontSize: 18, TextColor: #aaccff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
     Sounds: (
                            MouseHover: (SoundPath: "Selection_Hover.ogg", Volume: 1.0),
                            Activate: (SoundPath: "Selection_Press.ogg", Volume: 1.0)
                        )
);

@WipButtonStyle = TextButtonStyle(
    Default: (Background: #0a0c10, LabelStyle: (FontSize: 18, TextColor: #55606c, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #0a0c10, LabelStyle: (FontSize: 18, TextColor: #55606c, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #0a0c10, LabelStyle: (FontSize: 18, TextColor: #55606c, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@DoneStyle = TextButtonStyle(
    Default: (Background: "DoneButton_Background.png", LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: "DoneButton_Hovered_Background.png", LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: "DoneButton_Pressed_Background.png", LabelStyle: (FontSize: 16, TextColor: #aaccff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
     Sounds: (
                            MouseHover: (SoundPath: "Selection_Hover.ogg", Volume: 1.0),
                            Activate: (SoundPath: "Selection_Press.ogg", Volume: 1.0)
                        )
);

Group {
    Anchor: (Width: 460, Height: 520);
    Background: #000000(1);
    LayoutMode: Top;
    Padding: (Full: 24);

    Group {
        LayoutMode: Left;
        Label {
               Text: "";
               Background: "SOUL_MEDITATION.png";
               Anchor: (Height: 40, Width: 200);
               Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true);
                }
    }


    Label #MeditateHint {
        Text: "Center yourself and restore your spirit";
        Anchor: (Height: 26);
        Style: (FontSize: 14, TextColor: #88aacc);
    }

    Group { Anchor: (Height: 18); }

    TextButton #MeditateButton {
        Text: "Meditate";
        Anchor: (Height: 62);
        Style: @MenuButtonStyle;
        Padding: (Left: 16);
    }
    Group { Anchor: (Height: 10); }

    TextButton #UnlockButton {
        Text: "Unlock New Kido";
        Anchor: (Height: 62);
        Style: @MenuButtonStyle;
        Padding: (Left: 16);
    }
    Group { Anchor: (Height: 10); }

    TextButton #StatsButton {
        Text: "View Stats";
        Anchor: (Height: 62);
        Style: @MenuButtonStyle;
        Padding: (Left: 16);
    }
    Group { Anchor: (Height: 10); }

    TextButton #WipButton {
        Text: "WIP";
        Anchor: (Height: 62);
        Style: @WipButtonStyle;
        Padding: (Left: 16);
    }

    Group { Anchor: (Height: 14); }

    TextButton #DoneButton {
        Text: "Close";
        Anchor: (Height: 40);
        Style: @DoneStyle;
        Padding: (Left: 16);
    }
}
