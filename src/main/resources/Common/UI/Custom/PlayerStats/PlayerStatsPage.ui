@CloseButtonStyle = TextButtonStyle(
    Default: (Background: #2a1a1a, LabelStyle: (FontSize: 18, TextColor: #ffaaaa, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #5a2a2a, LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1a0a0a, LabelStyle: (FontSize: 18, TextColor: #ff8888, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
    Anchor: (Width: 720, Height: 640);
    Background: #000000(1);
    LayoutMode: Top;
    Padding: (Full: 24);

    Group {
        LayoutMode: Left;
        Anchor: (Height: 20);

        Group { Anchor: (Width: 632); }

        TextButton #CloseButton {
            Text: "";
            Anchor: (Width: 40, Height: 40);
            Style: @CloseButtonStyle;
        }
    }

    Group { Anchor: (Height: 4); }

    Group {
            LayoutMode: Left;
            Label {
                    Text: "";
                    Background: "STATS.png" ;
                    Anchor: (Height: 90, Width: 200);
                    Style: (FontSize: 26, TextColor: #ffffff, RenderBold: true);
                }
          }


    Group { Anchor: (Height: 20); }

    Label #RaceLabel {
        Text: "";
        Anchor: (Height: 32);
        Style: (FontSize: 18, TextColor: #ffffff);
    }

    Group { Anchor: (Height: 4); }

    Label #TotalKillsLabel {
        Text: "";
        Anchor: (Height: 32);
        Style: (FontSize: 18, TextColor: #ffffff);
    }

    Group { Anchor: (Height: 4); }

    Label #HollowKillsLabel {
        Text: "";
        Anchor: (Height: 32);
        Style: (FontSize: 18, TextColor: #ffffff);
    }

    Group { Anchor: (Height: 4); }

    Label #HadoLabel {
        Text: "";
        Anchor: (Height: 32);
        Style: (FontSize: 18, TextColor: #ffffff);
    }

    Group { Anchor: (Height: 4); }

    Label #BakudoLabel {
        Text: "";
        Anchor: (Height: 32);
        Style: (FontSize: 18, TextColor: #ffffff);
    }

    Group { Anchor: (Height: 24); }

    Label #ShikaiHeader {
        Text: "";
        Anchor: (Height: 28);
        Style: (FontSize: 20, TextColor: #aaccff, RenderBold: true);
    }

    Group { Anchor: (Height: 8); }

    Label #ShikaiList {
        Text: "";
        Anchor: (Height: 200);
        Style: (FontSize: 17, TextColor: #ffe9a8);
    }
}
