@PlaceholderButtonStyle = TextButtonStyle(
    Default: (Background: #0d1117(0.95), LabelStyle: (FontSize: 20, TextColor: #666666, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #1a2030(0.95), LabelStyle: (FontSize: 20, TextColor: #aaaaaa, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #050810(0.95), LabelStyle: (FontSize: 20, TextColor: #888888, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
    Anchor: (Width: 1450, Height: 850);
    Background: #000000(1);
    LayoutMode: Top;

    Group {
        LayoutMode: Top;
        Anchor: (Height: 812);
        Padding: (Full: 24);

        Group {
            Anchor: (Height: 40, Width: 700);
            Background: "DEFINE_YOUR_EXISTENCE.png";
        }

        Group { Anchor: (Height: 16); }

        Group {
            LayoutMode: Left;
            Anchor: (Height: 696);

            TextButton #ShinigamiButton {
                Text: "";
                FlexWeight: 1;
                Style: TextButtonStyle(
                    Default: (Background: "Shinigami.png", LabelStyle: (FontSize: 1, TextColor: #00000000)),
                    Hovered: (Background: "Shinigami_Hover.png", LabelStyle: (FontSize: 1, TextColor: #00000000)),
                    Pressed: (Background: "Shinigami.png", LabelStyle: (FontSize: 1, TextColor: #00000000)),
                    Sounds: (
                        MouseHover: (SoundPath: "RaceSelection_Hover.ogg", Volume: 1.0),
                        Activate: (SoundPath: "RaceSelection_Press.ogg", Volume: 1.0)
                    )
                );
            }

            TextButton #QuincyButton {
                Text: "";
                FlexWeight: 1;
                Style: TextButtonStyle(
                    Default: (Background: "Quincy.png", LabelStyle: (FontSize: 1, TextColor: #00000000)),
                    Hovered: (Background: "Quincy_Hover.png", LabelStyle: (FontSize: 1, TextColor: #00000000)),
                    Pressed: (Background: "Quincy.png", LabelStyle: (FontSize: 1, TextColor: #00000000)),
                    Sounds: (
                        MouseHover: (SoundPath: "RaceSelection_Hover.ogg", Volume: 1.0),
                        Activate: (SoundPath: "RaceSelection_Press.ogg", Volume: 1.0)
                    )
                );
            }

            TextButton #HollowButton {
                Text: "";
                FlexWeight: 1;
                Style: @PlaceholderButtonStyle;
            }

            TextButton #HumanButton {
                Text: "";
                FlexWeight: 1;
                Style: @PlaceholderButtonStyle;
            }
        }
    }

    Group {
        Anchor: (Height: 38);
        Background: "RaceSelec_Page_Footer.png";
    }
}
